<!DOCTYPE html>
<html lang="{{ page.props.meta ? page.props.meta.locale : 'fr' }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {{-- Meta SEO injectés côté serveur (FR36) — visibles par les crawlers avant hydratation React --}}
    <title inertia>{{ page.props.meta ? page.props.meta.title : 'Anta' }}</title>
    @if(page.props.meta)
      <meta name="description" content="{{ page.props.meta.description }}" />
      <meta property="og:title" content="{{ page.props.meta.ogTitle }}" />
      <meta property="og:description" content="{{ page.props.meta.ogDescription }}" />
      <meta property="og:type" content="{{ page.props.meta.ogType }}" />
    @end

    <link rel="icon" type="image/png" href="/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
    />

    @viteReactRefresh()
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    @inertia()
  </body>
</html>
