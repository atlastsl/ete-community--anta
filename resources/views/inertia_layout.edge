<!DOCTYPE html>
<html lang="{{ page.props.meta ? page.props.meta.locale : 'fr' }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {{-- Meta SEO injectés côté serveur (FR36) — visibles par les crawlers avant hydratation React --}}
    <title inertia>{{ page.props.meta ? page.props.meta.title : 'Anta' }}</title>
    @if(page.props.meta)
      <meta name="description" content="{{ page.props.meta.description }}" />
      <meta property="og:title" content="{{ page.props.meta.ogTitle }}" />
      <meta property="og:description" content="{{ page.props.meta.ogDescription }}" />
      <meta property="og:type" content="{{ page.props.meta.ogType }}" />
      @if(page.props.meta.ogUrl)
        <meta property="og:url" content="{{ page.props.meta.ogUrl }}" />
      @end
      {{-- Aperçu de partage : photo og.jpg des profils d'auteurs seulement (P2.5, D37 — Story 10.7) --}}
      @if(page.props.meta.ogImage)
        <meta property="og:image" content="{{ page.props.meta.ogImage }}" />
        {{-- Variante og.jpg : JPEG 1200×630 fixe (ImageService, AUTHOR_PHOTO_VARIANTS), D-10.7-2 --}}
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/jpeg" />
      @end
      <meta name="twitter:card" content="{{ page.props.meta.ogImage ? 'summary_large_image' : 'summary' }}" />
    @end

    <link rel="icon" type="image/png" href="/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
    />

    @viteReactRefresh()
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    @inertia()
  </body>
</html>
