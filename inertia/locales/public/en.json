  "privacy": {
    "title": "Privacy Policy",
    "intro": {
      "heading": "Introduction",
      "body": "The Anta website (hereinafter \"the Site\") is a community digital library. We are committed to protecting the privacy of our visitors. This policy describes the data we collect, its purpose, and your rights."
    },
    "data_collected": {
      "heading": "Data collected",
      "body": "The Site only collects the following data: a language preference cookie (i18n_lang) storing your choice between French and English; anonymous viewing statistics (number of views and downloads per production, without visitor identification). No visitor user accounts are created, and no personal data is requested from visitors."
    },
    "data_usage": {
      "heading": "Use of data",
      "body": "The language cookie is used solely to display the site in your chosen language on your next visit. Viewing statistics are used to measure interest in productions and improve the catalogue."
    },
    "data_retention": {
      "heading": "Data retention",
      "body": "The language cookie is retained for one year. Viewing statistics are retained in aggregate and anonymous form indefinitely."
    },
    "rights": {
      "heading": "Your rights",
      "body": "In accordance with the General Data Protection Regulation (GDPR), you have the right to access, rectify, and delete your data. You can delete the language cookie at any time through your browser settings."
    },
    "contact": {
      "heading": "Contact",
      "body": "For any questions regarding this policy, you can contact us at: contact@anta.community"
    }
  },
