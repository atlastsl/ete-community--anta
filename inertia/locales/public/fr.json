  "privacy": {
    "title": "Politique de confidentialité",
    "intro": {
      "heading": "Introduction",
      "body": "Le site Anta (ci-après « le Site ») est une bibliothèque numérique communautaire. Nous nous engageons à protéger la vie privée des visiteurs. Cette politique décrit les données collectées, leur finalité et vos droits."
    },
    "data_collected": {
      "heading": "Données collectées",
      "body": "Le Site collecte uniquement les données suivantes : un cookie de préférence de langue (i18n_lang) stockant votre choix entre français et anglais ; des statistiques de consultation anonymes (nombre de vues et de téléchargements par production, sans identification du visiteur). Aucun compte utilisateur visiteur n'est créé, aucune donnée personnelle n'est demandée aux visiteurs."
    },
    "data_usage": {
      "heading": "Utilisation des données",
      "body": "Le cookie de langue sert exclusivement à afficher le site dans la langue choisie lors de votre prochaine visite. Les statistiques de consultation permettent de mesurer l'intérêt pour les productions et d'améliorer le catalogue."
    },
    "data_retention": {
      "heading": "Durée de conservation",
      "body": "Le cookie de langue est conservé pendant un an. Les statistiques de consultation sont conservées de manière agrégée et anonyme sans limite de durée."
    },
    "rights": {
      "heading": "Vos droits",
      "body": "Conformément au Règlement Général sur la Protection des Données (RGPD), vous disposez d'un droit d'accès, de rectification et de suppression de vos données. Vous pouvez supprimer le cookie de langue à tout moment via les paramètres de votre navigateur."
    },
    "contact": {
      "heading": "Contact",
      "body": "Pour toute question relative à cette politique, vous pouvez nous contacter à l'adresse : contact@anta.community"
    }
  },
