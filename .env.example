# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=                          # node ace generate:key
APP_NAME=Anta
APP_URL=http://${HOST}:${PORT}
VITE_APP_NAME=Anta

# Session
SESSION_DRIVER=cookie
SESSION_AGE=2h                    # NFR6 — durée d'inactivité avant expiration (parse-duration : '2h', '30m', '1d')

# Base de données (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=anta
DB_SSL=false                      # true pour le pooler Supabase, false en local/CI sans SSL

# Cloudflare R2 (Story 1.3)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=anta-productions
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Email — Mailgun (principal) / Resend (secondaire) (Story 1.4)
MAIL_MAILER=mailgun               # 'mailgun' | 'resend'
MAIL_FROM_ADDRESS=contact@mg.anta.peraha.com
MAIL_FROM_NAME=Anta
RESEND_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.anta.peraha.com

# Super Admin initial (Story 1.5)
SUPER_ADMIN_EMAIL=admin@anta.peraha.com
SUPER_ADMIN_PASSWORD=
