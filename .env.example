# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=                          # node ace generate:key
APP_NAME=Anta
APP_URL=http://${HOST}:${PORT}
VITE_APP_NAME=Anta

# Session
SESSION_DRIVER=cookie

# Base de données (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=anta

# Cloudflare R2 (Story 1.3)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=anta-productions
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Email — Resend (principal) / Mailgun (backup) (Story 1.4)
MAIL_DRIVER=resend
RESEND_API_KEY=
MAILGUN_API_KEY=
MAIL_FROM_ADDRESS=noreply@anta.community
MAIL_FROM_NAME=Anta

# 2FA TOTP (Epic 2)
TOTP_APP_NAME=Anta

# Super Admin initial (Story 1.5)
SUPER_ADMIN_EMAIL=admin@anta.community
SUPER_ADMIN_PASSWORD=
