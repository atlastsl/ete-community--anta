{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "strict": true,
    "rootDir": "./",
    "jsx": "react",
    "outDir": "./build",
    "paths": {
      "~/*": ["./inertia/*"]
    }
  },
  "references": [{ "path": "./tsconfig.inertia.json" }],
  "exclude": [
    "node_modules",
    "build",
    "inertia",
    "tests/unit/i18n",
    "tests/unit/design_system"
  ]
}
