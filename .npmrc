# Force l'installation des devDependencies même avec NODE_ENV=production.
# Render/plateformes PaaS mettent NODE_ENV=production → npm saute les devDeps,
# mais `node ace build` (assembler, tsc, vite, @poppinss/ts-exec) en a besoin.
# `include` l'emporte sur le `omit=dev` induit par NODE_ENV.
include=dev
